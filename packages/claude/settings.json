{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(.secrets)",
      "Read(.secrets.*)",
      "Read(**/.secrets)",
      "Read(**/.secrets.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(.secrets)",
      "Edit(.secrets.*)",
      "Edit(**/.secrets)",
      "Edit(**/.secrets.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(.secrets)",
      "Write(.secrets.*)",
      "Write(**/.secrets)",
      "Write(**/.secrets.*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "skipDangerousModePermissionPrompt": true
}
