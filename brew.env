# Homebrew 镜像：清华 TUNA（https://mirrors.tuna.tsinghua.edu.cn/help/homebrew/）
#
# install.sh 会把本文件软链到 ~/.homebrew/brew.env，之后每次 brew 命令都会自己读它，
# 不依赖 ~/.zshrc，GUI / 非交互场景也生效；全新机器上还没有 brew 时，install.sh 先
# load_env 本文件，导出给官方安装脚本用（它认 HOMEBREW_BREW_GIT_REMOTE / HOMEBREW_CORE_GIT_REMOTE）
#
# 格式按 brew 的解析规则写：每行 HOMEBREW_XXX=value，不加 export、不加引号、
# 行尾不能写注释（brew 会把注释当成值的一部分），注释只能单独成行
#
# 只管 Homebrew 自身、formula 清单和 bottle；cask 仍从各厂商官网下，第三方 tap 仍走 GitHub
# 不需要镜像（如海外）：把下面几行注释掉即可

## brew 本体的 git 仓库（brew update 用）
HOMEBREW_BREW_GIT_REMOTE=https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git
## homebrew-core（只在关闭 API 模式、需要本地 tap core 时用到）
HOMEBREW_CORE_GIT_REMOTE=https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-core.git
## formula / cask 清单（formula.jws.json 约 35MB，官方 formulae.brew.sh 在国内很慢）
HOMEBREW_API_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api
## 预编译 bottle（默认是 ghcr.io）
HOMEBREW_BOTTLE_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles
## brew 内部用 pip 装 Python 依赖时的源
HOMEBREW_PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
